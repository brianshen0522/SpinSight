daemon off;

error_log /dev/stdout info;

events {
    worker_connections 1024;
}

rtmp {
    server {
        listen 1935;
        chunk_size 4096;

        application live {
            live on;
            record off;
        }
    }
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    sendfile off;
    access_log /dev/stdout combined;

    server {
        listen 8080;
        server_name _;

        location = /stat {
            rtmp_stat all;
            rtmp_stat_stylesheet stat.xsl;
        }

        location = /stat.xsl {
            root /www/static;
        }

        location = /health {
            access_log off;
            return 200 "ok\n";
        }
    }
}
