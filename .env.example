# RTMP source consumed by the transcoder container
STREAM_URL=rtmp://your-rtmp-host:1935/live/output

# Seconds to wait before reconnecting to the stream
RECONNECT_WAIT=3

# Calibration values
CROP_REGION=[260,40,1450,1020]
OUTER_ELLIPSE=[982.97, 559.16, 741.16, 1008.55, 88.90]
INNER_ELLIPSE=[980.83, 537.85, 609.10, 836.95, 88.87]

# RGB color ranges: [R_lo, R_hi, G_lo, G_hi, B_lo, B_hi]
COLOR_RED=[65, 255, 0, 55, 0, 55]
COLOR_GREEN=[0, 49, 59, 99, 30, 80]
COLOR_BLACK=[0, 58, 0, 52, 9, 98]

# Pixel-count thresholds for blob filtering
MIN_BLOCK_SIZE=2000
MAX_BLOCK_SIZE=9000

# If true, ignore blobs above the ring center
FILTER_UP_MODE=true
